<div
  class="position-absolute card shadow"
  style="font-size: 0.75rem"
  _="on mousedown halt"
>
  <ul class="list-group list-group-flush">
    <li
      class="list-group-item bg-light d-flex justify-content-between align-items-center"
      tal:condition="parsed"
    >
      ${parsed.label()}
      <!-- <small style="font-variant-numeric: tabular-nums"
        >{parsed.date.isoformat()}</small
      > -->
    </li>
    <li
      class="list-group-item bg-light d-flex justify-content-between align-items-center"
      tal:condition="not parsed"
    >
      ${value} &nbsp;
      <small class="text-danger-emphasis">invalid recurrence rule</small>
    </li>
    <li
      class="list-group-item d-flex justify-content-between align-items-center"
      tal:repeat="option options"
      data-picker-value="${option.label()}"
      _="on click
          set (previous <input/>)'s value to my @data-picker-value
          blur (previous <input/>)
          -- Chosen, so there is nothing left to choose from.
          hide the closest .picker to me
          "
    >
      ${option.label()}
      <!-- <small style="font-variant-numeric: tabular-nums"
        >{option.date.isoformat()}</small
      > -->
    </li>
  </ul>
</div>
