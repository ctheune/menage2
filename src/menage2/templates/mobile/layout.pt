<!DOCTYPE html metal:define-macro="layout">
<html lang="${request.locale_name}">

<head>
  <meta charset="utf-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0, user-scalable=no">
  <title>${base_name}</title>
  <link rel="icon" type="image/svg+xml" href="${request.static_url('menage2:static/logo.svg')}" />
  <link rel="apple-touch-icon" href="${request.static_url('menage2:static/logo.png')}">
  <meta name="mobile-web-app-title" tal:attributes="content base_name">
  <meta name="mobile-web-app-capable" content="yes">

  <link href="${request.static_url('menage2:static/bootstrap.min.css')}" rel="stylesheet">
  <link href="${request.static_url('menage2:static/bootstrap-icons.min.css')}" rel="stylesheet">
  <link href="${request.static_url('menage2:static/theme.css')}" rel="stylesheet">

  <script src="${request.static_url('menage2:static/htmx.min.js')}" defer></script>
  <script src="${request.static_url('menage2:static/hyperscript.min.js')}" defer></script>
  <script src="${request.static_url('menage2:static/menage.js')}" defer></script>
  <script src="${request.static_url('menage2:static/bootstrap.bundle.min.js')}" defer></script>
  <script src="${request.static_url('menage2:static/form-json.js')}" defer></script>
  <meta name="theme-color" content="#04081A">
</head>

<body>

  <!-- min-vh-100 keeps the page background under a short list; the padding
       clears the fixed bottom nav so the last row stays reachable. -->
  <div class="bg-body-secondary min-vh-100 pb-5">
    <div metal:define-slot="content">No content</div>
    <div class="pb-4"></div>
  </div>


<div class="fixed-bottom">

  <!-- Actions for whatever is ticked, sitting directly above the nav. At the
       top of the page the notch and the header swallow them. Hidden until
       something is selected, so the bar does not crowd the list. -->
  <div class="d-flex gap-2 p-2 bg-body-tertiary border-top d-none" id="mobile-selection-actions"
       _="on change from #todo-list
            -- Count them: an empty query result is still truthy, so a bare
            -- `if` would leave the bar up after the last untick.
            set picked to <input.todo-checkbox:checked/> in #todo-list
            if picked.length > 0
              remove .d-none from me
            else
              add .d-none to me
            end">
    <button type="submit" form="mobile-batch-form" name="action" value="done"
            class="btn btn-sm btn-primary flex-grow-1">Done</button>
    <button type="submit" form="mobile-batch-form" name="action" value="hold"
            class="btn btn-sm btn-outline-secondary flex-grow-1">Hold</button>
    <button type="submit" form="mobile-batch-form" name="action" value="activate"
            class="btn btn-sm btn-outline-secondary flex-grow-1">Activate</button>
  </div>

  <nav class="nav navbar nav-pills bg-body-tertiary justify-content-around">

  <a href="#offcanvasBottom" class="nav-link link-secondary" data-bs-toggle="offcanvas" role="button"
    aria-controls="offcanvasBottom" aria-label="Menu">
    <i class="bi bi-list fs-1"></i>
  </a>
  <a href="${request.route_url('list_todos')}" class="nav-link active" aria-label="Tasks">
    <i class="bi bi-check2-square fs-1"></i>
  </a>
  <!-- Adding is a sheet on the list page rather than a route of its own, so
       the list underneath keeps its place. -->
  <a href="#mobile-add" class="nav-link link-secondary" role="button" aria-label="New task"
     data-bs-toggle="offcanvas" aria-controls="mobile-add">
    <i class="bi bi-plus-square fs-1"></i>
  </a>
  </nav>

</div>

<div class="offcanvas offcanvas-bottom h-auto" tabindex="-1" id="offcanvasBottom"
     aria-labelledby="offcanvasBottomLabel">
  <div class="offcanvas-header">
    <h5 class="offcanvas-title" id="offcanvasBottomLabel">Tasks</h5>
    <button type="button" class="btn-close" data-bs-dismiss="offcanvas" aria-label="Close"></button>
  </div>
  <div class="offcanvas-body">
    <!-- Which items to show: a status and a filter, and every link carries
         both. Changing one otherwise drops the other back to its default and
         the list quietly turns into a different list.

         Full page loads, so the pair is in the URL and the list, its refresh
         trigger and the back button all stay in step. -->

    <h6 class="text-body-secondary text-uppercase small">Show</h6>
    <div class="list-group mb-3">
      <a tal:repeat="entry status_labels.items()"
         href="${request.route_url('list_todos', _query=dict(status=entry[0], filter=filter_mode))}"
         class="list-group-item list-group-item-action ${'active' if entry[0] == status else ''}"
         aria-current="${'page' if entry[0] == status else None}">${entry[1]}</a>
    </div>

    <h6 class="text-body-secondary text-uppercase small">Whose</h6>
    <div class="list-group mb-3">
      <a tal:repeat="entry filter_modes.items()"
         href="${request.route_url('list_todos', _query=dict(status=status, filter=entry[0]))}"
         class="list-group-item list-group-item-action d-flex justify-content-between align-items-center ${'active' if entry[0] == filter_mode else ''}"
         aria-current="${'page' if entry[0] == filter_mode else None}">
        ${entry[1]}
        <!-- How many that list holds right now: on a phone this is what says
             whether opening it is worth the tap. -->
        <span class="badge rounded-pill text-bg-secondary">${filter_counts[entry[0]]}</span>
      </a>
    </div>

    <form method="post" action="${request.route_url('logout')}" class="m-0 d-grid">
      <button type="submit" class="btn btn-outline-secondary">
        <i class="bi bi-door-open"></i> Log off
      </button>
    </form>
  </div>
</div>

<!-- Picture viewer.

     The desktop has one already, but it is eighty lines of plain JavaScript
     with module-level state and a document-wide click listener. A phone needs
     less than that: Bootstrap owns the modal, and hyperscript only says which
     picture is in it.
-->
<div class="modal fade" id="mobile-photo" tabindex="-1" aria-hidden="true"
     aria-labelledby="mobile-photo-name"
     _="on showPhoto(pic)
          set my shown to pic
          set #mobile-photo-image's src to pic@data-full-url
          set #mobile-photo-image's alt to pic@alt
          -- textContent, not innerHTML: the caption is a filename someone
          -- else chose.
          set #mobile-photo-name's textContent to pic@alt
          -- A single picture needs no way through to the next one.
          set others to <img/> in (the closest .todo-attachment-thumbs to pic)
          if others.length > 1
            remove .d-none from #mobile-photo-nav
          else
            add .d-none to #mobile-photo-nav
          end">
  <div class="modal-dialog modal-fullscreen">
    <div class="modal-content bg-dark">
      <div class="modal-header border-0">
        <span class="text-white-50 small text-truncate" id="mobile-photo-name"></span>
        <button type="button" class="btn-close btn-close-white" aria-label="Close"
                data-bs-dismiss="modal"></button>
      </div>
      <!-- Tapping the picture puts it away again, the way a phone gallery does. -->
      <div class="modal-body d-flex align-items-center justify-content-center p-0"
           data-bs-dismiss="modal">
        <img id="mobile-photo-image" src="" alt=""
             class="img-fluid mh-100 object-fit-contain" />
      </div>
      <div class="modal-footer border-0 justify-content-between d-none"
           id="mobile-photo-nav">
        <button type="button" class="btn btn-link text-white" aria-label="Previous"
                _="on click
                     set here to #mobile-photo's shown
                     if no here exit end
                     set other to the previous <img/> from here
                       within (the closest .todo-attachment-thumbs to here)
                       with wrapping
                     if other send showPhoto(pic: other) to #mobile-photo end">
          <i class="bi bi-chevron-left fs-3"></i>
        </button>
        <button type="button" class="btn btn-link text-white" aria-label="Next"
                _="on click
                     set here to #mobile-photo's shown
                     if no here exit end
                     set other to the next <img/> from here
                       within (the closest .todo-attachment-thumbs to here)
                       with wrapping
                     if other send showPhoto(pic: other) to #mobile-photo end">
          <i class="bi bi-chevron-right fs-3"></i>
        </button>
      </div>
    </div>
  </div>
</div>
<!-- Clicked by hyperscript so Bootstrap still handles the backdrop and the
     scroll lock, the same way the sheets are opened. -->
<button type="button" class="d-none" id="mobile-photo-open"
        data-bs-toggle="modal" data-bs-target="#mobile-photo"></button>

</body>

</html>
