<div metal:use-macro="load: ./layout.pt">

  <div metal:fill-slot="content">
    <form xmlns:hx-on="http://htmx.org/hx-on"
          id="mobile-batch-form"
          hx-post="${request.route_url('todo_batch_action')}"
          hx-ext="form-json"
          hx-swap="none">
      <!-- Interval for the postpone batch action; the postpone picker binds to it. -->
      <input type="hidden" name="interval" id="interval" value="1d" />

      <!-- Swipes submit through these. Hidden because the gesture is the
           only way to reach them; they carry the action the same way the
           desktop batch menu does. -->
      <button type="submit" name="action" value="done" id="swipe-done" class="d-none" tabindex="-1"
              aria-hidden="true"></button>
      <button type="submit" name="action" value="hold" id="swipe-hold" class="d-none" tabindex="-1"
              aria-hidden="true"></button>
      <button type="submit" name="action" value="postpone" id="swipe-postpone" class="d-none" tabindex="-1"
              aria-hidden="true"></button>
      <button type="submit" name="action" value="activate" id="swipe-activate" class="d-none" tabindex="-1"
              aria-hidden="true"></button>
      <!-- overflow-hidden clips the swipe: without it a dragged row runs past
           the card, widens the page and exposes the backdrop beside it. -->
      <div class="card overflow-hidden">
        <!-- Which list this is. The filters live behind the menu, so without
             a line saying so a non-default one just looks like items having
             gone missing. It opens the menu too, since that is where you go
             next if it is not the list you wanted. -->
        <a class="card-header d-flex justify-content-between align-items-center
                  text-decoration-none link-body-emphasis small"
           id="mobile-list-header"
           href="#offcanvasBottom" role="button" data-bs-toggle="offcanvas"
           aria-controls="offcanvasBottom">
          <span>${filter_modes[filter_mode]} <span class="text-body-secondary">·</span>
            ${status_labels[status]}</span>
          <i class="bi bi-chevron-down"></i>
        </a>
        <!-- hx-swap is spelled out because the form's "none" is inherited. -->
        <div id="todo-list" data-status="${status}"
             hx-trigger="load, todo-updated from:body, focus from:window"
             hx-swap="innerHTML"
             hx-get="${request.route_url('list_todo_groups', _query=dict(filter=filter_mode, status=status))}"
             _="on visibilitychange from document
                  -- Returning to the app is the phone's version of the desktop's
                  -- window focus, which mobile browsers do not reliably fire.
                  -- Reusing the ordinary refresh event updates the nav counts too.
                  if document.visibilityState is 'visible'
                    trigger 'todo-updated' on body
                  end"></div>
      </div>
    </form>

    <tal:block tal:replace="structure undo_form_html" />

    <!-- Edit sheet. Each row carries its own hx-get with its id, so nothing
         has to be selected first; the row opens the sheet as it fires. -->
    <div class="offcanvas offcanvas-bottom h-75" tabindex="-1" id="mobile-edit"
         aria-labelledby="mobile-edit-title">
      <div class="offcanvas-header">
        <h5 class="offcanvas-title" id="mobile-edit-title">Edit task</h5>
        <button type="button" class="btn-close" data-bs-dismiss="offcanvas"
                aria-label="Close"></button>
      </div>
      <div class="offcanvas-body" id="mobile-edit-body"></div>
      <!-- Opened from a row's htmx response and closed by the empty panel
           after a save. Hyperscript clicks these rather than toggling classes,
           so Bootstrap still handles the backdrop and the scroll lock. -->
      <button type="button" class="d-none" id="mobile-edit-open"
              data-bs-toggle="offcanvas" data-bs-target="#mobile-edit"></button>
      <button type="button" class="d-none" id="mobile-edit-close"
              data-bs-dismiss="offcanvas"></button>
    </div>

    <!-- Add sheet, opened from the bottom nav. -->
    <div class="offcanvas offcanvas-bottom h-75" tabindex="-1" id="mobile-add"
         aria-labelledby="mobile-add-title">
      <div class="offcanvas-header">
        <h5 class="offcanvas-title" id="mobile-add-title">New task</h5>
        <button type="button" class="btn-close" aria-label="Close"
                data-bs-dismiss="offcanvas"></button>
      </div>
      <div class="offcanvas-body">
        <!-- Same fields as the edit sheet. The title still takes markers, so
             a quick `Buy bread #shopping` works without touching the rest. -->
        <form hx-post="${request.route_url('add_todo')}" hx-target="body">
          <tal:block tal:replace="structure add_fields_html" />
          <div class="d-flex gap-2">
            <button type="button" class="btn btn-outline-secondary flex-grow-1"
                    data-bs-dismiss="offcanvas">Cancel</button>
            <button type="submit" class="btn btn-primary flex-grow-1">Add</button>
          </div>
        </form>
      </div>
    </div>

  </div>

</div>
