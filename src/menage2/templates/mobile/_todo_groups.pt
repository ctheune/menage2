<!--

  touchstart
  tochmove
  tochend

  toggle

-->

<tal:block tal:repeat="group groups">
  <div class="tag-group-header" data-tag="${group['full_tag']}" data-open="true" _="on click
         if @data-open is 'true'
           set @data-open to 'false'
           add .d-none to the next <ul/>
         else
           set @data-open to 'true'
           remove .d-none from the next <ul/>
         end">
    <span class="tag-toggle">▾</span>
    <span class="tag-breadcrumb">${group['breadcrumbs']}</span>
  </div>

  <ul class="todo-group-list mb-0 list-unstyled">
    <li tal:repeat="todo group['items']" id="todo-${todo.id}" class="todo-item" data-todo-id="${todo.id}"
        data-todo-text="${todo.text}" _="
         init
            set :swipe to 0
            set :origin to 0
            set :swipeAction to null
         live
            set *transform to 'translateX(' + :swipe + 'px)'
         on touchstart(changedTouches)
            set :origin to (first of changedTouches)'s pageX
            set *background-color to 'var(--bs-warning-bg-subtle)'
         on touchcancel
            transition :swipe to 0 over 200ms
            remove {background-color}
         on touchend
            if :swipeAction is null then
              transition :swipe to 0 over 200ms
              remove {background-color}
              exit
            else
              -- A swipe ticks its own row and submits the batch form, so the
              -- checkbox is the single way an action learns what to act on.
              set (the first <input.todo-checkbox/> in me)'s checked to true
              if :swipeAction is 'done' then call #swipe-done.click() end
              if :swipeAction is 'hold' then call #swipe-hold.click() end
              if :swipeAction is 'postpone' then call #swipe-postpone.click() end
            end
            set :swipeAction to null
         on touchmove(changedTouches)
            set :swipe to ((first of changedTouches)'s pageX - :origin)
            measure my width
            set :threshold to it's width / 4
            if :swipe > :threshold then
              set *background-color to 'var(--bs-success-bg-subtle)'
              set :swipeAction to 'done'
            else
              if :swipe < -2*:threshold then
                set *background-color to 'var(--bs-info-bg-subtle)'
                set :swipeAction to 'postpone'
              else
                if :swipe < -:threshold then
                  set *background-color to 'var(--bs-secondary-bg-subtle)'
                  set :swipeAction to 'hold'
                else
                  set *background-color to 'var(--bs-warning-bg-subtle)'
                  set :swipeAction to null
                end
              end
            end
          ">
      <div class="todo-content d-flex py-2 px-3 align-items-center gap-2"
           tal:define="stand_in python:sorted(covering & todo.assignees);
                       others python:sorted(todo.assignees - covering)">
        <!-- Selecting and editing are separate targets: the box picks the
             row out, anywhere else opens it. Ticking does not act on its own
             — the action bar above the list does, once something is picked. -->
        <span class="flex-shrink-0">
          <input type="checkbox"
                 name="todo_ids[]"
                 value="${todo.id}"
                 class="form-check-input todo-checkbox"
                 id="todo-checkbox-${todo.id}"
                 aria-label="Select"
                 hx-preserve />
        </span>
        <span class="flex-grow-1 d-flex align-items-center gap-2 small" style="min-width: 0"
              hx-get="${request.route_url('todo_details_panel', _query=[('todo_ids[]', todo.id)])}"
              hx-target="#mobile-edit-body"
              hx-swap="innerHTML"
              hx-params="none"
              _="on htmx:afterOnLoad call #mobile-edit-open.click()">
          <span class="text-truncate" style="min-width: 0">
            <span class="todo-title">${todo.text}</span>
            <span class="d-block" tal:condition="todo.note or todo.links_rel">
              <span tal:condition="todo.note" class="todo-note-display text-muted"
                    tal:content="structure render_note_html(todo.note)"></span>
              <tal:block tal:condition="todo.links_rel" tal:repeat="link todo.links_rel">
                <a tal:attributes="href link.url" target="_blank" rel="noopener noreferrer"
                   class="todo-link-badge d-inline-block text-decoration-none me-1">
                  <i class="bi bi-link-45deg"></i>
                  <tal:block tal:condition="link.label">
                    ${link.label}</tal:block>
                </a>
              </tal:block>
            </span>
          </span>
          <span tal:condition="todo.attachments" class="todo-attachment-thumbs flex-shrink-0"
                _="on click
                     -- A picture opens the viewer and nothing else: the tap
                     -- would otherwise reach the row and open it for editing.
                     if target matches 'img'
                       halt the event
                       send showPhoto(pic: target) to #mobile-photo
                       call #mobile-photo-open.click()
                     end">
            <tal:block tal:repeat="att todo.attachments">
              <img class="todo-attachment-thumb" loading="lazy" tal:attributes="src python:request.route_url('todo_attachment_thumbnail', todo_id=todo.id, uuid=att.uuid);
                                   data-full-url python:request.route_url('todo_attachment_full', todo_id=todo.id, uuid=att.uuid);
                                   alt att.original_filename" />
            </tal:block>
          </span>
        </span>

        <span tal:condition="todo.protocol_run_id" class="todo-protocol-link flex-shrink-0 small">
          <i class="bi bi-clipboard-check"></i>
        </span>

        <tal:block tal:condition="python:todo.due_date and todo.due_date != today">
          <span tal:define="overdue python:todo.due_date < today" tal:attributes="class python: 'todo-due small flex-shrink-0 ' + ('todo-due--overdue' if overdue else 'todo-due--future');
                                title python: format.date(todo.due_date, format='full')">
            ${python:date_ago(todo.due_date, today) if overdue else
            format.date(todo.due_date, format='medium')}
          </span>
        </tal:block>

        <span tal:condition="todo.recurrence_id" class="todo-recurrence flex-shrink-0 small"
              tal:attributes="title python:_recurrence_label(todo)">
          ↻
          <span class="todo-recurrence-label d-none d-sm-inline">${_recurrence_label(todo)}</span>
        </span>

        <span tal:condition="todo.assignees" class="d-inline d-sm-none">
          @
        </span>

        <!-- Everyone assigned to this team is away, so it is on this list
             until somebody is back. Saying whose it is stops it reading as
             work that has always been yours — and says it in place of the
             assignee below, which would only repeat the team's name. -->
        <span
          tal:condition="stand_in"
          class="badge rounded-pill bg-warning-subtle text-warning-emphasis flex-shrink-0 fw-normal"
          title="Everyone assigned to this team is away"
        >covering @${stand_in[0]}</span>
        <span tal:condition="others" class="todo-assignees flex-shrink-0 small text-muted d-none d-sm-inline">
          <tal:block tal:repeat="a others">@${a}
          </tal:block>
        </span>
      </div>
    </li>
  </ul>
</tal:block>

<div tal:condition="not groups" class="todo-list-empty">
  <span>Nothing to do!</span>
</div>
