<!-- The assignee field: same widget as the tag field, one per person.

     Needs `assignees_json` in scope — JSON, like the tag field, so that a
     name with a space in it survives the round trip. It used to be a
     space-separated string, which meant a team could not be called one.
-->
<div class="mb-3" hx-disinherit="*" id="field-assignees"
  data-assignees="${assignees_json}"
  _="init set $assignees to ((my @data-assignees) as JSON)">

  <label>Assignees</label>

  <div class="form-control"
       _="on click
      -- The picker hangs inside this box, so a click on one of its rows
      -- lands here too. That is a choice being made, not a request to
      -- type — taking the focus back would reopen the picker that the
      -- choice just closed.
      set box to the closest .picker to target
      if box exit end
      focus first <span.new-assignee/> in me
      halt

    on keydown[key is '@' and target is body] from body
      focus first <span.new-assignee/> in me
      halt">
    <script type="text/hyperscript-template" live>
        #for assignee in $assignees
          <input type="hidden" name="assignees[]" value="$${assignee}"/>
          <span class="badge rounded-pill text-bg-secondary">$${assignee}
            <i class="bi bi-x" role="button" aria-label="Remove assignee" _="on click remove previous <input/>'s value from $assignees"></i>
          </span>
        #else
          <input type="hidden" name="clear_fields[]" value="assignees"/>
        #end
      </script>

    <span class="new-assignee" contentEditable="plaintext-only"
      hx-get="${request.route_url('assignee_picker')}"
      hx-target="next .picker"
      hx-trigger="focus, input delay:100ms"
      hx-vals="js:{value: this.textContent}"
      hx-params="value"
      _="on focus
         show next .picker

       on blur
         hide next .picker

       on keydown[key is 'Escape']
         blur me
         halt

       on keydown[key is 'Backspace']
         -- Backspace at the very start takes the one before the cursor.
         set caret to window.getSelection()
         if $assignees and caret.isCollapsed and caret.anchorOffset is 0 then
            remove $assignees[-1]
         end
       end

       on keydown[key is 'ArrowDown']
         set items to <li[data-picker-value]/> in next .picker
         if items
           set active to first <li.picker-selected/> in next .picker
           if active
             remove .picker-selected from active
             set nxt to next <li[data-picker-value]/> from active
             if nxt add .picker-selected to nxt
             else add .picker-selected to first in items end
           else
             add .picker-selected to first in items
           end
         end
        halt

        on keydown[key is 'ArrowUp']
         set items to <li[data-picker-value]/> in next .picker
         if items
           set active to first <li.picker-selected/> in next .picker
           if active
             remove .picker-selected from active
             set prv to previous <li[data-picker-value]/> from active
             if prv add .picker-selected to prv
             else add .picker-selected to last in items end
           else
             add .picker-selected to last in items
           end
         end
       halt

       on keydown[key is ' ']
        -- Only what the picker offered: an assignee is a reference now, so
        -- a name nobody answers to would be refused by the save. Typed
        -- text that matched nothing stays in the field to be corrected
        -- rather than becoming a pill that cannot be stored.
        set active to first <li.picker-selected/> in next .picker
        if active
          append active's @data-picker-value to $assignees
          clear me
          focus me
        end
      halt

       on keydown[key is 'Enter']
         set active to first <li.picker-selected/> in next .picker
         if active
           if not ($assignees contains active's @data-picker-value) then
             append active's @data-picker-value to $assignees
           end
           clear me
           blur me
           focus me
         else
           if not my textContent then
             send submit to closest <form/>
           end
         end
         halt

       on assigneeSelected
         set active to first <li.picker-selected/> in next .picker
         if active and not ($assignees contains active's @data-picker-value) then
           append active's @data-picker-value to $assignees
         end
         clear me
         blur me
      "></span>&ZeroWidthSpace;<!-- ensure form control height -->
    <div class="picker"></div>
  </div>
</div>
