<!-- Editing one ingredient: the same tag field and the same files as
     everything else. An ingredient is an item, so it gets the item's
     affordances rather than a tag vocabulary of its own.
-->
<form class="card card-body mt-2"
      hx-post="${request.route_url('ingredient_update', id=ingredient.id)}"
      hx-target="closest li"
      hx-select="li"
      hx-swap="outerHTML">

  <div metal:use-macro="load: ./_todo_tag_field.pt"></div>
  <div metal:use-macro="load: ./_item_files.pt"></div>

  <div class="d-flex gap-2">
    <button type="submit" class="btn btn-sm btn-primary">Save</button>
    <button type="button" class="btn btn-sm btn-outline-secondary"
            _="on click remove the closest <form/>">Cancel</button>
  </div>
</form>
