<tal:block>
  <form id="todo-form"
        hx-post="${request.route_url('add_todo')}"
        hx-target="body"
        class="mb-2">
    <div class="input-group">
        <input name="text" class="flex-grow-1" style="flex:1;min-width:6rem;cursor:text;word-break:break-word;min-height:1.5em;" id="input-add-todo-text" />
    </div>
  </form>
</tal:block>
