<div class="col-md-6" id="details-pane">
  <div class="card" id="details-panel">
    <form hx-put="${request.route_url('todo_update', id=todo.id)}" hx-target="#details-pane" hx-swap="outerHTML"
      hx-ext="form-json" id="todo-edit-form">

      <div class="card-body">

        <div id="field-title">
          <input type="hidden" name="text" id="input-todo-text" value="${todo.text}" />

          <h5 class="card-title" contenteditable="true"
            _="bind me to #input-todo-text
               on keydown[key is 'Enter'] from me blur
               on keydown[key is 'e'] from body
                 if the tagName of target is 'INPUT' or the tagName of target is 'TEXTAREA' or the isContentEditable of target
                   exit end
                 focus me
                 then halt
               on keydown[key is 'Escape'] blur">${todo.text}</h5>
        </div>

        <div class="mb-3" hx-disinherit="*" id="field-tags" data-tags="${tags_json}"
          _="init set $tags to ((my @data-tags) as JSON)">

          <label>Tags</label>

          <div class="form-control" _="on click or keydown[key is 's' and target is body] from body
              focus first <span.new-tag/> in me
              then halt
              ">
            <script type="text/hyperscript-template" live>
            #for tag in $tags
              <input type="hidden" name="tags[]" value="$${tag}"/>
              <span class="badge rounded-pill text-bg-secondary">$${tag}
                <i class="bi bi-x" role="button" aria-label="Remove tag" _="on click remove previous <input/>'s value from $tags"></i>
              </span>
            #else
              <input type="hidden" name="clear_fields[]" value="tags"/>
            #end
            </script>

            <span class="new-tag" contentEditable="plaintext-only" hx-get="${request.route_url('todo_tag_picker')}"
              hx-target="next .picker" hx-trigger="focus, input delay:100ms" hx-vals="js:{value: this.textContent}"
              hx-params="value" _="
                 on focus
                    show next .picker

                 on blur
                    hide next .picker

                 on keydown[key is 'Escape']
                    blur me
                    halt

                 on keydown[key is 'Backspace']
                   if isCaretAtStart(me) and $tags then
                      remove $tags[-1]
                   end
                 end

                 on keydown[key is 'ArrowDown']
                   set items to <li[data-picker-value]/> in next .picker
                   if items
                     set active to first <li.picker-selected/> in next .picker
                     if active
                       remove .picker-selected from active
                       set nxt to next <li[data-picker-value]/> from active
                       if nxt add .picker-selected to nxt
                       else add .picker-selected to first in items end
                     else
                       add .picker-selected to first in items
                     end
                   end
                  halt

                  on keydown[key is 'ArrowUp']
                   set items to <li[data-picker-value]/> in next .picker
                   if items
                     set active to first <li.picker-selected/> in next .picker
                     if active
                       remove .picker-selected from active
                       set prv to previous <li[data-picker-value]/> from active
                       if prv add .picker-selected to prv
                       else add .picker-selected to last in items end
                     else
                       add .picker-selected to last in items
                     end
                   end
                 halt

                 on keydown[key is ' ']
                  set active to first <li.picker-selected/> in next .picker
                  if active
                    append active's @data-picker-value to $tags
                  else
                    if my textContent then
                      append my textContent to $tags
                    end
                  end
                  clear me
                  focus me
                halt

                 on keydown[key is 'Enter'] or tagSelected
                   set active to first <li.picker-selected/> in next .picker
                   if active
                     append active's @data-picker-value to $tags
                   else
                     if my textContent then
                       append my textContent to $tags
                     else
                       send submit to closest <form/>
                     end
                   end
                   blur me
                   clear me
                   focus me
                   halt
                "></span>&ZeroWidthSpace;<!-- ensure from control height -->
            <div class="picker"></div>
          </div>
        </div>

        <div class="mb-3" hx-disinherit="*" id="field-due-date">
          <label for="due_date" class="form-label">Due</label>
          <input type="text" class="form-control picker-target" name="due_date" placeholder="YYYY-MM-DD or smart date"
            value="${todo.due_date.isoformat() if todo.due_date else ''}"
            hx-get="${request.route_url('todo_date_picker')}" hx-target="next .picker"
            hx-trigger="focus, input changed delay:100ms" hx-vals="js:{value: this.value}" hx-params="value" _="on keydown[key is 'd' and target.matches('body')] from body
            remove .d-none from me
            focus halt
           on keydown[key is 'Escape']
            blur me
            halt
           on keydown[key is 'ArrowDown']
             set items to <li[data-picker-value]/> in next .picker
             if items
               set active to first <li.picker-selected/> in next .picker
               if active
                 remove .picker-selected from active
                 set nxt to next <li[data-picker-value]/> from active
                 if nxt add .picker-selected to nxt
                 else add .picker-selected to first in items end
               else
                 add .picker-selected to first in items
               end
             end
           halt
           on keydown[key is 'ArrowUp']
             set items to <li[data-picker-value]/> in next .picker
             if items
               set active to first <li.picker-selected/> in next .picker
               if active
                 remove .picker-selected from active
                 set prv to previous <li[data-picker-value]/> from active
                 if prv add .picker-selected to prv
                 else add .picker-selected to last in items end
               else
                 add .picker-selected to last in items
               end
             end
           halt
           on keydown[key is 'Enter']
             set active to first <li.picker-selected/> in next .picker
             if active
               set my value to active's @data-picker-value
               blur me
             else
               send submit to closest <form/>
             end
           halt
           on focus
            remove .d-none from me
            show next .picker
           on blur hide next .picker" />
          <div class="picker"></div>
        </div>

        <div class="mb-3" hx-disinherit="*" id="field-recurrence">
          <label for="recurrence" class="form-label">Repeat</label>
          <input type="text" class="form-control picker-target" name="recurrence" value="${_recurrence_label(todo)}"
            hx-get="${request.route_url('todo_recurrence_picker')}"
            hx-target="next .picker"
            hx-trigger="focus, input changed delay:100ms"
            hx-vals="js:{value: this.value}"
            hx-params="value"
            _="on keydown[key is 'f' and target.matches('body')] from body
                 remove .d-none from me
                 focus halt

               on keydown[key is 'Escape']
                 blur
                 halt

               on keydown[key is 'ArrowDown']
                 set items to <li[data-picker-value]/> in next .picker
                 if items
                   set active to first <li.picker-selected/> in next .picker
                   if active
                     remove .picker-selected from active
                     set nxt to next <li[data-picker-value]/> from active
                     if nxt add .picker-selected to nxt
                     else add .picker-selected to first in items end
                   else
                     add .picker-selected to first in items
                   end
                 end
                 halt

               on keydown[key is 'ArrowUp']
                 set items to <li[data-picker-value]/> in next .picker
                 if items
                   set active to first <li.picker-selected/> in next .picker
                   if active
                     remove .picker-selected from active
                     set prv to previous <li[data-picker-value]/> from active
                     if prv add .picker-selected to prv
                     else add .picker-selected to last in items end
                   else
                     add .picker-selected to last in items
                   end
                 end
                 halt

               on keydown[key is 'Enter']
                 set active to first <li.picker-selected/> in next .picker
                 if active
                   set my value to active's @data-picker-value
                   blur me
                 else
                   send submit to closest <form/>
                 end
                 halt

               on focus
                show next .picker

               on blur
                hide next .picker" />
          <div class="picker"></div>
        </div>

        <div class="mb-3">
          <input type="hidden" name="note" id="input-todo-note" value="${todo.note}" />

          <label for="note">Note</label>

          <div contenteditable="true" class="form-control" style="font-size: 80%;"
            _="bind me to #input-todo-note
               on keydown[key is '~' and target.matches('body')] from body
                 focus me
                 halt
               on keydown[key is 'Escape']
                 blur
                 halt">
          </div>
        </div>

        <div class="mb-3" hx-disinherit="*" id="field-assignees"
          data-assignees="${' '.join(sorted(todo.assignees) if todo.assignees else [])}"
          _="init
               set $assignees to my @data-assignees split by ' ' as Array
               if not $assignees then
                 set $assignees to []
               end">

          <label>Assignees</label>

          <div class="form-control"
               _="on click or keydown[key is '@' and target is body] from body
                    focus first <span.new-assignee/> in me
                    then halt">
            <script type="text/hyperscript-template" live>
                #for assignee in $assignees
                  <input type="hidden" name="assignees[]" value="$${assignee}"/>
                  <span class="badge rounded-pill text-bg-secondary">$${assignee}
                    <i class="bi bi-x" role="button" aria-label="Remove assignee" _="on click remove previous <input/>'s value from $assignees"></i>
                  </span>
                #else
                  <input type="hidden" name="clear_fields[]" value="assignees"/>
                #end
              </script>

            <span class="new-assignee" contentEditable="plaintext-only"
              hx-get="${request.route_url('todo_assignee_picker')}"
              hx-target="next .picker"
              hx-trigger="focus, input delay:100ms"
              hx-vals="js:{value: this.textContent}"
              hx-params="value"
              _="on focus
                 show next .picker

               on blur
                 hide next .picker

               on keydown[key is 'Escape']
                 blur me
                 halt

               on keydown[key is 'Backspace']
                 if isCaretAtStart(me) and $assignees then
                    remove $assignees[-1]
                 end
               end

               on keydown[key is 'ArrowDown']
                 set items to <li[data-picker-value]/> in next .picker
                 if items
                   set active to first <li.picker-selected/> in next .picker
                   if active
                     remove .picker-selected from active
                     set nxt to next <li[data-picker-value]/> from active
                     if nxt add .picker-selected to nxt
                     else add .picker-selected to first in items end
                   else
                     add .picker-selected to first in items
                   end
                 end
                halt

                on keydown[key is 'ArrowUp']
                 set items to <li[data-picker-value]/> in next .picker
                 if items
                   set active to first <li.picker-selected/> in next .picker
                   if active
                     remove .picker-selected from active
                     set prv to previous <li[data-picker-value]/> from active
                     if prv add .picker-selected to prv
                     else add .picker-selected to last in items end
                   else
                     add .picker-selected to last in items
                   end
                 end
               halt

               on keydown[key is ' ']
                set active to first <li.picker-selected/> in next .picker
                if active
                  append active's @data-picker-value to $assignees
                else
                  if my textContent then
                    append my textContent to $assignees
                  end
                end
                clear me
                focus me
              halt

               on keydown[key is 'Enter']
                 set active to first <li.picker-selected/> in next .picker
                 if active and not ($assignees contains active's @data-picker-value) then
                   append active's @data-picker-value to $assignees
                 else
                   if my textContent then
                     if not ($assignees contains my textContent) then
                       append my textContent to $assignees
                     end
                   else
                     send submit to closest <form/>
                   end
                 end
                 clear me
                 blur me
                 focus me
                 halt

               on assigneeSelected
                 set active to first <li.picker-selected/> in next .picker
                 if active and not ($assignees contains active's @data-picker-value) then
                   append active's @data-picker-value to $assignees
                 end
                 clear me
                 blur me
              "></span>&ZeroWidthSpace;<!-- ensure from control height -->
            <div class="picker"></div>
          </div>
        </div>

        <div class="mb-3" hx-disinherit="*" id="field-links" data-links="${links_json}"
          _="init
               set $links to ((my @data-links) as JSON)">

          <label>Links</label>

          <div class="form-control"
            _="on click[target is me]
                 focus first <span.new-link/> in me
                 then halt
               on keydown[key is 'l' and target is body] from body
                 focus first <span.new-link/> in me
                 then halt
            ">
            <script type="text/hyperscript-template" live>
              #for link in $links indexed by i
                <input type="hidden" name="links.$${i}.label" value="$${link.label}"/>
                <input type="hidden" name="links.$${i}.url" value="$${link.url}"/>
                <span class="badge rounded-pill text-bg-secondary text-nowrap">
                  <a target="_blank" rel="noopener noreferrer" href="$${link.url}" class="link-light">$${link.label}</a>
                  <i class="bi bi-pencil" role="button" aria-label="Edit link"
                     _="on click
                       log $links[$${i}].url
                       set (next .picker's @data-id) to $${i}
                       set (next .picker's @data-url) to $links[$${i}].url
                       set (next .picker's @data-label) to $links[$${i}].label
                       show next .picker
                       focus last <input/> in next .picker"></i>
                  <i class="bi bi-x" role="button" aria-label="Remove link"></i>
                </span>
              #else
                <input type="hidden" name="clear_fields[]" value="links"/>
              #end
              </script>

            <span class="new-link" contentEditable="plaintext-only"
              _="
                 on keydown[key is 'Escape']
                   clear me
                   blur me
                   halt

                 on keydown[key is 'Enter']
                   if my textContent then
                     set $newUrl to my textContent
                     make an Object from { url: $newUrl, label: $newUrl} called newLink
                     log newLink
                     append newLink to $links
                     clear me
                     blur me
                     focus me
                   end
                   halt

                 on keydown[key is 'Backspace']
                   if isCaretAtStart(me) and $links then
                      remove $links[-1]
                   end
                 end
                  "></span>&ZeroWidthSpace;
            <div class="picker position-absolute card shadow w-50 p-2" style="display:none"
              data-url="" data-label="" data-id=""
              _="on 'cancel-update-link'
                  hide me
                 on 'update-link'
                  set id to my @data-id
                  set $links[id].url to @data-url
                  set $links[id].label to @data-label
                  hide me
                 ">
              <label style="font-size:.85rem;font-weight:600;display:block;margin-bottom:.5rem">URL</label>
              <input class="form-control form-control-sm mb-2" name="link.url" placeholder="https://… or obsidian://…" value=""
                  _="bind me to (closest <div/>)'s @data-url
                     on keydown[key is 'Enter']
                        trigger 'update-link'
                        halt
                     on keydown[key is 'Escape']
                        trigger 'cancel-update-link'
                        halt
                        " />
              <label style="font-size:.85rem;font-weight:600;display:block;margin-bottom:.5rem">Label <span style="font-weight:400;color:#6c757d">(optional)</span></label>
              <input class="form-control form-control-sm" name="link.label" placeholder="Link text…" value=""
                  _="bind me to (closest <div/>)'s @data-label
                     on keydown[key is 'Enter']
                        trigger 'update-link'
                        halt
                     on keydown[key is 'Escape']
                        trigger 'cancel-update-link'
                        halt
                        "/>
              <div class="d-flex gap-2 mt-2 justify-content-end">
                <button type="button" class="btn btn-sm btn-link text-muted"
                  _="on click trigger 'cancel-update-link'">Cancel</button>
                <button type="button" class="btn btn-sm btn-dark"
                  _="on click trigger 'update-link'">Set</button>
            </div>
          </div>
        </div>

        <div class="mb-3" hx-disinherit="*" id="field-attachments" data-attachments="${attachments_json}"
          _="init set $attachments to ((my @data-attachments) as JSON)">
          <label>Files</label>

          <div class="form-control container">
            <div class="row">
              <script type="text/hyperscript-template" live>
              #for attachment in $attachments
                <div class="col-lg-4 col-md-12 mb-4">
                  <img src="$${attachment.url}" alt="$${attachment.filename}" class="w-100 shadow-1-strong rounded mb-4"/>
                </div>
              #end
              </script>
              <div class="col-lg-4 col-md-12 mb-4" _="on drop(dataTransfer)
                   log 'drop'
                   halt the event
                   remove .bg-info
                   if dataTransfer.files.length > 0 then
                     add .bg-info-subtle
                     make a FormData called fd
                     repeat for file in dataTransfer.files indexed by i
                       log file
                       log 'file' + i
                       call fd.append('file' + i, file)
                     end
                     log fd
                     fetch ${request.route_url('todo_attachment_upload', id=todo.id)} with method:'POST', body: fd
                     remove .bg-info-subtle
                   end

                 on dragover(dataTransfer)
                   log 'over'
                   set dataTransfer's dropEffect to 'copy'
                   halt

                 on dragenter
                   add .bg-info
                   log 'enter'

                 on dragleave
                   remove .bg-info
                   log 'leave'
              ">
                <i class="bi bi-images"></i>
              </div>
            </div>
          </div>
        </div>

        <input class="btn btn-primary" type="submit" value="Save">

      </div>
    </form>

    <!-- Protocol run items: rendered server-side when a run is attached -->
    <tal:block tal:condition="todo.protocol_run">
      <div class="card-body">
        <h5>Checklist</h5>
      </div>
      <div id="protocol-run" tal:define="run todo.protocol_run; items todo.protocol_run.sorted_items()"
        data-run-id="${todo.protocol_run.id}" data-todo-route="${request.route_url('list_todos')}">

        <ul class="todo-group-list mb-0 list-unstyled">
          <li tal:repeat="item items" id="run-item-${item.id}" tal:attributes="class python: 'protocol-run-item todo-item status-' + item.status.value;
                              data-item-id item.id;
                              data-done-url request.route_url('run_item_done', id=run.id, item_id=item.id);
                              data-send-url request.route_url('run_item_send', id=run.id, item_id=item.id);
                              data-edit-url request.route_url('run_item_edit', id=run.id, item_id=item.id)">
            <div class="todo-content d-flex py-1 px-3 align-items-baseline gap-2">
              <span class="protocol-run-item-marker flex-shrink-0">
                <tal:block tal:condition="item.status.value == 'pending'">○</tal:block>
                <tal:block tal:condition="item.status.value == 'done'">✓</tal:block>
                <tal:block tal:condition="item.status.value == 'sent_to_todo'">→</tal:block>
              </span>
              <span class="flex-grow-1 small" style="min-width:0">
                <span
                  tal:attributes="class python: 'text-decoration-line-through text-muted' if item.status.value != 'pending' else ''">${item.text}</span>
                <span tal:repeat="tag python:sorted(item.tags)"
                  class="badge bg-secondary rounded-pill ms-1">#${tag}</span>
                <span tal:condition="item.note" class="d-block text-muted" style="font-size:0.75rem">${item.note}</span>
              </span>
              <tal:block tal:condition="item.status.value == 'pending'">
                <button type="button" class="protocol-run-action flex-shrink-0 btn btn-link btn-sm p-1 text-success"
                  data-action="done" title="Done (c)">✓</button>
                <button type="button" class="protocol-run-action flex-shrink-0 btn btn-link btn-sm p-1 text-primary"
                  data-action="send" title="Send to todo list (t)">→</button>
                <button type="button" class="protocol-run-action flex-shrink-0 btn btn-link btn-sm p-1 text-muted"
                  data-action="edit" title="Edit before sending (e)">✎</button>
              </tal:block>
            </div>
          </li>
        </ul>
      </div>
    </tal:block>

    <ul _="live
        empty me
        repeat for e in #todo-edit-form's elements
          append `<li>$${e.name}: $${e.value}</li>` to me
        end
       end">
    </ul>
  </div>
</div>
