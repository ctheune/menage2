<div class="col-md-6" id="details-pane">
  <div class="card" id="details-panel">
    <form hx-put="${request.route_url('todo_update', id=todo.id)}" hx-target="#details-pane" hx-swap="outerHTML"
      hx-ext="form-json" id="todo-edit-form">

      <div class="card-body">

        <div id="field-title">
          <input type="hidden" name="text" id="input-todo-text" value="${todo.text}" />

          <h5 class="card-title" contenteditable="true"
            _="bind me to #input-todo-text
               on keydown[key is 'Enter'] from me blur
               on keydown[key is 'e'] from body
                 if the tagName of target is 'INPUT' or the tagName of target is 'TEXTAREA' or the isContentEditable of target
                   exit end
                 -- With a checklist open, 'e' edits the current run item.
                 if #protocol-run exit end
                 focus me
                 then halt
               on keydown[key is 'Escape'] blur">${todo.text}</h5>
        </div>

        <div metal:use-macro="load: ./_todo_tag_field.pt"></div>

        <div class="mb-3" hx-disinherit="*" id="field-due-date">
          <label for="due_date" class="form-label">Due</label>
          <input type="text" class="form-control picker-target" name="due_date" placeholder="YYYY-MM-DD or smart date"
            value="${todo.due_date.isoformat() if todo.due_date else ''}"
            hx-get="${request.route_url('todo_date_picker')}" hx-target="next .picker"
            hx-trigger="focus, input changed delay:100ms" hx-vals="js:{value: this.value}" hx-params="value" _="on keydown[key is 'd' and target.matches('body')] from body
            remove .d-none from me
            focus halt
           on keydown[key is 'Escape']
            blur me
            halt
           on keydown[key is 'ArrowDown']
             set items to <li[data-picker-value]/> in next .picker
             if items
               set active to first <li.picker-selected/> in next .picker
               if active
                 remove .picker-selected from active
                 set nxt to next <li[data-picker-value]/> from active
                 if nxt add .picker-selected to nxt
                 else add .picker-selected to first in items end
               else
                 add .picker-selected to first in items
               end
             end
           halt
           on keydown[key is 'ArrowUp']
             set items to <li[data-picker-value]/> in next .picker
             if items
               set active to first <li.picker-selected/> in next .picker
               if active
                 remove .picker-selected from active
                 set prv to previous <li[data-picker-value]/> from active
                 if prv add .picker-selected to prv
                 else add .picker-selected to last in items end
               else
                 add .picker-selected to last in items
               end
             end
           halt
           on keydown[key is 'Enter']
             set active to first <li.picker-selected/> in next .picker
             if active
               set my value to active's @data-picker-value
               blur me
             else
               send submit to closest <form/>
             end
           halt
           on focus
            remove .d-none from me
            show next .picker
           on blur hide next .picker" />
          <div class="picker"></div>
        </div>

        <div class="mb-3" hx-disinherit="*" id="field-recurrence">
          <label for="recurrence" class="form-label">Repeat</label>
          <input type="text" class="form-control picker-target" name="recurrence" value="${_recurrence_label(todo)}"
            hx-get="${request.route_url('todo_recurrence_picker')}"
            hx-target="next .picker"
            hx-trigger="focus, input changed delay:100ms"
            hx-vals="js:{value: this.value}"
            hx-params="value"
            _="on keydown[key is 'f' and target.matches('body')] from body
                 remove .d-none from me
                 focus halt

               on keydown[key is 'Escape']
                 blur
                 halt

               on keydown[key is 'ArrowDown']
                 set items to <li[data-picker-value]/> in next .picker
                 if items
                   set active to first <li.picker-selected/> in next .picker
                   if active
                     remove .picker-selected from active
                     set nxt to next <li[data-picker-value]/> from active
                     if nxt add .picker-selected to nxt
                     else add .picker-selected to first in items end
                   else
                     add .picker-selected to first in items
                   end
                 end
                 halt

               on keydown[key is 'ArrowUp']
                 set items to <li[data-picker-value]/> in next .picker
                 if items
                   set active to first <li.picker-selected/> in next .picker
                   if active
                     remove .picker-selected from active
                     set prv to previous <li[data-picker-value]/> from active
                     if prv add .picker-selected to prv
                     else add .picker-selected to last in items end
                   else
                     add .picker-selected to last in items
                   end
                 end
                 halt

               on keydown[key is 'Enter']
                 set active to first <li.picker-selected/> in next .picker
                 if active
                   set my value to active's @data-picker-value
                   blur me
                 else
                   send submit to closest <form/>
                 end
                 halt

               on focus
                show next .picker

               on blur
                hide next .picker" />
          <div class="picker"></div>

          <!-- Clearing the field above takes this one item out of the
               repetition. Stopping ends the repetition itself, which is the
               other thing people mean, and cannot be said by typing. -->
          <button type="button" tal:condition="todo.recurrence_id"
                  id="stop-repeating"
                  class="btn btn-link btn-sm px-0 text-body-secondary"
                  hx-post="${request.route_url('todo_stop_repeating', id=todo.id)}"
                  hx-target="#details-pane"
                  hx-swap="outerHTML">
            Stop repeating, keep what is there
          </button>
        </div>

        <div class="mb-3">
          <input type="hidden" name="note" id="input-todo-note" value="${todo.note}" />

          <label for="note">Note</label>

          <div contenteditable="true" class="form-control" style="font-size: 80%;"
            _="bind me to #input-todo-note
               on keydown[key is '~' and target.matches('body')] from body
                 focus me
                 halt
               on keydown[key is 'Escape']
                 blur
                 halt">
          </div>
        </div>

        <div metal:use-macro="load: ./_todo_assignee_field.pt"></div>

        <div class="mb-3" hx-disinherit="*" id="field-links" data-links="${links_json}"
          _="init
               set $links to ((my @data-links) as JSON)">

          <label>Links</label>

          <div class="form-control"
            _="on click[target is me]
                 focus first <span.new-link/> in me
                 then halt
               on keydown[key is 'l' and target is body] from body
                 focus first <span.new-link/> in me
                 then halt
            ">
            <script type="text/hyperscript-template" live>
              #for link in $links indexed by i
                <input type="hidden" name="links.$${i}.label" value="$${link.label}"/>
                <input type="hidden" name="links.$${i}.url" value="$${link.url}"/>
                <span class="badge rounded-pill text-bg-secondary text-nowrap">
                  <a target="_blank" rel="noopener noreferrer" href="$${link.url}" class="link-light">$${link.label}</a>
                  <i class="bi bi-pencil" role="button" aria-label="Edit link"
                     _="on click
                       log $links[$${i}].url
                       set (next .picker's @data-id) to $${i}
                       set (next .picker's @data-url) to $links[$${i}].url
                       set (next .picker's @data-label) to $links[$${i}].label
                       show next .picker
                       focus last <input/> in next .picker"></i>
                  <i class="bi bi-x" role="button" aria-label="Remove link"
                     _="on click remove $links[$${i}]"></i>
                </span>
              #else
                <input type="hidden" name="clear_fields[]" value="links"/>
              #end
              </script>

            <span class="new-link" contentEditable="plaintext-only"
              _="
                 on keydown[key is 'Escape']
                   clear me
                   blur me
                   halt

                 on keydown[key is 'Enter']
                   if my textContent then
                     set newUrl to my textContent
                     -- Emptied before asking, not after: naming takes a round
                     -- trip, and anything typed in the meantime would be wiped
                     -- by a clear that arrived late.
                     clear me
                     -- Ask what it should be called before putting it in the
                     -- list. The same shortening runs on the server either
                     -- way; doing it now means the label is on screen and
                     -- editable straight away, rather than turning up after
                     -- a save has taken it out of reach.
                     set labelUrl to '${request.route_url('todo_link_label')}?url='
                                     + encodeURIComponent(newUrl)
                     fetch labelUrl
                     make an Object from { url: newUrl, label: it } called newLink
                     append newLink to $links
                   end
                   halt

                 on keydown[key is 'Backspace']
                   if isCaretAtStart(me) and $links then
                      remove $links[-1]
                   end
                 end
                  "></span>&ZeroWidthSpace;
            <div class="picker position-absolute card shadow w-50 p-2" style="display:none"
              data-url="" data-label="" data-id=""
              _="on 'cancel-update-link'
                  hide me
                 on 'update-link'
                  set id to my @data-id
                  set $links[id].url to @data-url
                  set $links[id].label to @data-label
                  hide me
                 ">
              <label style="font-size:.85rem;font-weight:600;display:block;margin-bottom:.5rem">URL</label>
              <input class="form-control form-control-sm mb-2" name="link.url" placeholder="https://… or obsidian://…" value=""
                  _="bind me to (closest <div/>)'s @data-url
                     on keydown[key is 'Enter']
                        trigger 'update-link'
                        halt
                     on keydown[key is 'Escape']
                        trigger 'cancel-update-link'
                        halt
                        " />
              <label style="font-size:.85rem;font-weight:600;display:block;margin-bottom:.5rem">Label <span style="font-weight:400;color:#6c757d">(optional)</span></label>
              <input class="form-control form-control-sm" name="link.label" placeholder="Link text…" value=""
                  _="bind me to (closest <div/>)'s @data-label
                     on keydown[key is 'Enter']
                        trigger 'update-link'
                        halt
                     on keydown[key is 'Escape']
                        trigger 'cancel-update-link'
                        halt
                        "/>
              <div class="d-flex gap-2 mt-2 justify-content-end">
                <button type="button" class="btn btn-sm btn-link text-muted"
                  _="on click trigger 'cancel-update-link'">Cancel</button>
                <button type="button" class="btn btn-sm btn-dark"
                  _="on click trigger 'update-link'">Set</button>
              </div>
            </div>
          </div>
        </div>

        <div class="mb-3" hx-disinherit="*" id="field-attachments" data-attachments="${attachments_json}"
          _="init set $attachments to ((my @data-attachments) as JSON)">
          <label>Files</label>

          <div class="form-control container">
            <div class="row">
            <script type="text/hyperscript-template" live>
              <div style="display:grid; grid-template-columns: 1fr 1fr 1fr 1fr; column-gap: 1em;
  row-gap: 1em;">
              #for attachment in $attachments
                <img src="$${attachment.url}" alt="$${attachment.filename}" style="width: 100%; height: auto; aspect-ratio: 1 / 1; height: auto; min-width: 0; min-height: 0; object-fit: cover; display: block;" />
              #end
              <div class="bg-secondary-subtle d-flex align-items-center justify-content-center"  style="width: 100%; height: auto; aspect-ratio: 1 / 1; height: auto; min-width: 0; min-height: 0; object-fit: cover;"
                _="on drop(dataTransfer)
                   halt the event
                   remove .bg-info
                   if dataTransfer.files.length > 0 then
                     add .bg-info-subtle
                     make a FormData called fd
                     repeat for file in dataTransfer.files indexed by i
                       call fd.append('file' + i, file)
                     end
                     fetch ${request.route_url('todo_attachment_upload', id=todo.id)} with method:'POST', body: fd
                     remove .bg-info-subtle
                     add .bg-secondary-subtle
                   end

                 on dragover(dataTransfer)
                   set dataTransfer's dropEffect to 'copy'
                   halt

                 on dragenter
                   remove .bg-secondary-subtle
                   add .bg-info

                 on dragleave
                   remove .bg-info
                   add .bg-secondary-subtle
              ">
                  <i class="bi bi-upload" style="pointer-events: none;"></i>
              </div>
              </script>
            </div>
          </div>
        </div>

        <input class="btn btn-primary" type="submit" value="Save">

      </div>
    </form>

    <!-- Protocol run checklist — same partial the run actions swap in -->
    <tal:block tal:condition="todo.protocol_run">
      <div class="card-body">
        <h5>Checklist</h5>
      </div>
      <tal:block tal:replace="structure run_html" />
    </tal:block>

    <!-- XXX
    <ul _="live
        empty me
        repeat for e in #todo-edit-form's elements
          append `<li>$${e.name}: $${e.value}</li>` to me
        end
       end">
    </ul>
    -->
  </div>
</div>
