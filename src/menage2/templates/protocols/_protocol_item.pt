<!-- One line of the checklist. For an editor the whole line opens the
     editor beside the list, the same one an ingredient opens. -->
<li id="item-${item.id}" class="proto-item card mb-1">
  <div class="proto-item-view card-body py-1 px-3 d-flex align-items-center gap-2"
       hx-target="#item-pane"
       hx-swap="outerHTML"
       tal:attributes="hx-get python:request.route_url('item_panel', id=item.id) if is_editor else None;
                       role python:'button' if is_editor else None">
    <span class="flex-grow-1">${item.text}</span>
    <span tal:condition="item.attachments"
          class="flex-shrink-0" title="Has files"><i class="bi bi-paperclip"></i></span>
    <span tal:repeat="t python:sorted(item.tags)"
          class="badge rounded-pill bg-secondary">#${t}</span>
    <span tal:repeat="a python:sorted(item.assignees)"
          class="badge rounded-pill todo-assignee-pill-sm">@${a}</span>
    <span tal:condition="item.note" class="text-muted small">~${item.note}</span>
    <!-- Its click stops here, or the line would open the editor as well. -->
    <button tal:condition="is_editor"
            type="button"
            class="btn btn-link btn-sm p-0 text-danger flex-shrink-0"
            hx-post="${request.route_url('delete_protocol_item', id=protocol.id, item_id=item.id)}"
            hx-target="#item-${item.id}"
            hx-swap="outerHTML"
            hx-confirm="Delete this item?"
            title="Delete item"
            _="on click halt the event's bubbling">
      <i class="bi bi-trash3"></i>
    </button>
  </div>
</li>
