<div metal:use-macro="load: ../layout.pt">

  <span metal:fill-slot="title-mobile">${protocol.title}</span>
  <div metal:fill-slot="title">${protocol.title}</div>

  <span metal:fill-slot="actions">
    <form method="post" action="${request.route_url('start_protocol_run', id=protocol.id)}"
          class="d-inline m-0">
      <button type="submit" class="btn btn-sm btn-primary"><i class="bi bi-play-fill"></i>  Start a run now</button>
    </form>
    <tal:block tal:condition="is_editor">
      <form method="post" action="${request.route_url('archive_protocol', id=protocol.id)}"
            class="d-inline m-0"
            onsubmit="return confirm('Archive this protocol?')">
        <button type="submit" class="btn btn-sm btn-danger"><i class="bi bi-archive"></i> Archive</button>
      </form>
    </tal:block>
  </span>

  <div metal:fill-slot="content" class="container-fluid px-3 pt-3">
    <div class="row">
      <div class="col-lg-6">

    <!-- Title / tags / recurrence / note. For an editor the card opens the
         editor beside the list, as the lines do. Refetched when that editor
         saves; disinherit, because the card fetches its own editor and would
         otherwise inherit this block's hx-select and swap nothing. -->
    <div id="proto-header"
         hx-disinherit="*"
         hx-get="${request.route_url('edit_protocol', id=protocol.id)}"
         hx-trigger="item-updated from:body"
         hx-target="#proto-header"
         hx-select="#proto-header"
         hx-swap="outerHTML">
      <div class="card mb-3">
        <div class="proto-title-view card-body d-flex align-items-center gap-2 flex-wrap"
             hx-target="#item-pane"
             hx-swap="outerHTML"
             tal:attributes="hx-get python:request.route_url('item_panel', id=protocol.id) if is_editor else None;
                             role python:'button' if is_editor else None">
          <strong class="flex-grow-1">${protocol.title}</strong>
          <span tal:condition="protocol.attachments"
                class="flex-shrink-0" title="Has files"><i class="bi bi-paperclip"></i></span>
          <span tal:repeat="t python:sorted(protocol.tags)"
                class="badge rounded-pill bg-secondary">#${t}</span>
          <span tal:repeat="a python:sorted(protocol.assignees)"
                class="badge rounded-pill todo-assignee-pill-sm">@${a}</span>
          <span tal:condition="rule_label" class="text-warning-emphasis small">↻ ${rule_label}</span>
          <span tal:condition="protocol.note" class="text-muted small w-100">~${protocol.note}</span>
        </div>
      </div>
    </div>

    <!-- Items -->
    <h5 class="mt-4 mb-2">Items</h5>
    <tal:block tal:replace="structure items_html" />

    <!-- Add item — plain text, parsed the same way as a new todo -->
    <form tal:condition="is_editor"
          class="mt-3"
          id="proto-new-item-form"
          hx-post="${request.route_url('add_protocol_item', id=protocol.id)}"
          hx-target="#proto-items"
          hx-swap="outerHTML"
          _="on htmx:afterRequest
               set input to the first <input/> in me
               set input's value to ''
               focus input">
      <input type="text"
             name="text"
             class="form-control"
             autocomplete="off"
             placeholder="New item — text #tag @who ~note" />
    </form>

      </div>

      <!-- The editor, in the column beside the list and staying put while it scrolls.
           The same one an ingredient opens: a checklist, its lines and an
           ingredient are the same kind of thing underneath. -->
      <div class="col-lg-6 sticky-lg-top align-self-start d-none" id="item-pane"></div>

    </div>
  </div>
</div>
