<div
  class="position-absolute card shadow w-50"
  style="font-size: 0.75rem"
  _="on mousedown halt"
>
  <ul class="list-group list-group-flush">
    <li
      class="list-group-item d-flex justify-content-between align-items-center"
      tal:repeat="option options"
      data-picker-value="${option}"
      _="on click
          take .picker-selected from <li/> in closest <ul/> for me
          -- The new sheet on mobile has no pill widget to tell; there the
          -- field itself picks the click up.
          set entry to the previous <.new-assignee/>
          if entry send assigneeSelected to entry end
          "
    >
      <span tal:content="structure highlight(option, value)"></span>
    </li>
    <li
      class="list-group-item d-flex justify-content-between align-items-center"
      tal:condition="new"
      data-picker-value="${new}"
      _="on click
          take .picker-selected from <li/> in closest <ul/> for me
          -- The new sheet on mobile has no pill widget to tell; there the
          -- field itself picks the click up.
          set entry to the previous <.new-assignee/>
          if entry send assigneeSelected to entry end
          "
    >
      ${new}
      <small style="font-variant-numeric: tabular-nums">(new assignee)</small>
    </li>
  </ul>
</div>
