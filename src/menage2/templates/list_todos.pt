<div metal:use-macro="load: layout.pt">
  <span metal:fill-slot="title-mobile">TODO</span>
  <div metal:fill-slot="title">TODO</div>

  <span metal:fill-slot="actions">
    <form
      method="post"
      action="${request.route_url('todos_activate_all_on_hold')}"
      class="d-inline m-0"
    >
      <button type="submit" class="btn btn-sm btn-dark text-nowrap">
        <i class="bi bi-arrow-clockwise"></i> Activate all
      </button>
    </form>
  </span>

  <div metal:fill-slot="content" class="container-fluid px-0 px-md-3 pt-3">
    <!-- Add / edit todo form (shared across views; rendered server-side) -->
    <tal:block tal:replace="structure form_html" />

    <div class="row">
      <!-- Todo list -->
      <div class="col-md-6">
        <div class="card">
          <!-- Status tabs -->
          <div class="card-header">
            <ul class="nav nav-tabs card-header-tabs">
              <li class="nav-item">
                <a
                  href="${request.route_url('list_todos')}?filter=${filter_mode}&status=active"
                  class="nav-link ${'active' if status == 'active' else ''}"
                  >Active</a
                >
              </li>
              <li class="nav-item">
                <a
                  href="${request.route_url('list_todos')}?filter=${filter_mode}&status=on_hold"
                  class="nav-link ${'active' if status == 'on_hold' else ''}"
                  >On Hold</a
                >
              </li>
              <li class="nav-item">
                <a
                  href="${request.route_url('list_todos')}?filter=${filter_mode}&status=scheduled"
                  class="nav-link ${'active' if status == 'scheduled' else ''}"
                  >Scheduled</a
                >
              </li>
              <li class="nav-item">
                <a
                  href="${request.route_url('list_todos')}?filter=${filter_mode}&status=done"
                  class="nav-link ${'active' if status == 'done' else ''}"
                  >Done</a
                >
              </li>
            </ul>
          </div>
          <div
            id="todo-list"
            data-status="${status}"
            hx-trigger="load, todo-updated from:body, focus from:window"
            hx-get="${request.route_url('list_todo_groups', _query=dict(filter=filter_mode, status=status))}"
            _="on htmx:afterSwap trigger change on the first <form/> in me
                 on keydown[key is ']'] from body
                   if the tagName of target is 'INPUT' or the tagName of target is 'TEXTAREA' or the isContentEditable of target exit end
                   call setAllGroups(true)
                 on keydown[key is '['] from body
                   if the tagName of target is 'INPUT' or the tagName of target is 'TEXTAREA' or the isContentEditable of target exit end
                   call setAllGroups(false)
                 on keydown[key is 'u'] from body
                   if the tagName of target is 'INPUT' or the tagName of target is 'TEXTAREA' or the isContentEditable of target exit end
                   if no #undo-toast exit end
                   trigger undoRequested on body"
          ></div>
        </div>
      </div>

      <!-- Details pane (hidden until an item is selected or a run is opened) -->
      <div class="details-pane d-none" id="details-pane">
        <div class="todo-list-wrap run-panel-wrap" id="details-panel"></div>
      </div>
    </div>
  </div>
</div>
